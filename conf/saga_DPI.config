/*
* -----------------------------------
*  Nextflow config file for NVI Saga
* -----------------------------------
*/

report {
        enabled         = true
        file            = "${params.out_dir}/logs/nextflow_run_report.html"
		overwrite		= true
}

process {
	executor		= 'slurm'
	clusterOptions 	= '--job-name=Saga_nxf --account=nn9305k'
	queueSize		= 24
	errorStrategy	= 'retry'
	maxRetries		= 2
	cpus			= 4
	memory			= { 8.GB * task.attempt }
	time			= { params.time_multiplier * 2.h * task.attempt }

	// Process label definitions
	withLabel: 'pg_server_host' { 
		module = 'PostgreSQL/16.1-GCCcore-13.2.0'
        clusterOptions = '--nodes=1 --exclusive' // Request 1 entire node exclusively
        // Any other specific settings for this server setup process
		cpus = 1
        // memory = '4.GB'

    }

    // Configuration for client processes (as discussed before)
    withLabel: 'pg_client' {
        module = 'PostgreSQL/16.1-GCCcore-13.2.0'
        clusterOptions = { task.inputs.pg_server_hostname_file ? "--nodelist=${file(task.inputs.pg_server_hostname_file).text.trim()}" : null }
        // ... other settings for client processes ...
    }

	// RUN_NUCDIFF
	withLabel: process_high {
		cpus 		= 4
		memory		= 16.GB
	}
	withLabel: process_high_cpu_time {
		cpus        = 20
		time		= { params.time_multiplier * 48.h * task.attempt }
        }
	// ANNOTATE
	withLabel: process_high_memory {
		clusterOptions 	= '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
		memory			= 200.GB

	}
	// MERGE_DBS
	withLabel: process_high_memory_time {
        clusterOptions  = '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
		memory          = 64.GB
		time			= { params.time_multiplier * 8.h * task.attempt }
		cpus			= 1
        }

	withLabel: process_high_memory_cpu_time {
        clusterOptions  = '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
        memory          = 200.GB
		cpus			= 16
        time            = { params.time_multiplier * 48.h * task.attempt }
        }
	withLabel: process_long {
		time		= { params.time_multiplier * 48.h * task.attempt } 
	}
	// INPUT, PREPARE_NUCDIFF, PREPARE_VCF_ANNOTATOR, RUN_VCF_ANNOTATOR, WRANGLING_TO_DB
	withLabel: process_short {
		time		= { params.time_multiplier * 1.h * task.attempt }
		cpus		= 1
		memory		= { 4.GB * task.attempt }
	}
	withLabel: process_local {
		executor	= 'local'
	}

}
