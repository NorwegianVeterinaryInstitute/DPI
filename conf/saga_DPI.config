/*
* -----------------------------------
*  Nextflow config file for NVI Saga
* -----------------------------------
*/

report {
        enabled         = true
        file            = "${params.out_dir}/logs/nextflow_run_report.html"
		overwrite		= true
}

process {
	executor		= 'slurm'
	clusterOptions 	= '--job-name=Saga_nxf --account=nn9305k'
	queueSize		= 24
	errorStrategy	= 'retry'
	maxRetries		= 2
	cpus			= 4
	memory			= { 8.GB * task.attempt }
	time			= { params.time_multiplier * 2.h * task.attempt }

	// Process label definitions
	// for postgre server 
	  withLabel: 'pg_server_host' {
	  	// module contains pg_ctl, initdb
        module = 'PostgreSQL/16.1-GCCcore-13.2.0' 

        // Request one entire node exclusively for the PG server and its co-located clients.
        // The 'time' here should be enough for the *entire workflow* as this process waits.
        clusterOptions = '--nodes=1'
        cpus = 2          // Example: CPUs for the PostgreSQL server itself (can be shared by clients if node is exclusive)
        memory = '8.GB'   // Example: Memory for PostgreSQL server
		time = '1h'      // Example: Max workflow duration
        //time = '48h'      // Example: Max workflow duration
    }

    // Configuration for postgre client processes (as discussed before) - need also duckdb and python
	withLabel: 'pg_client' {
		module = 'PostgreSQL/16.1-GCCcore-13.2.0'
		// duckdB 
		// python ? 

		// clusterOptions = { task.inputs.pg_server_hostname_file ? "--nodelist=${file(task.inputs.pg_server_hostname_file).text.trim()}" : null }
        clusterOptions = {
            def node_file = task.inputs.pg_node_info_file
            if (node_file && (node_file instanceof java.nio.file.Path || node_file instanceof nextflow.file.Path)) {
                def hostname = node_file.text.trim()
                if (hostname) {
                    // Tell SLURM to run this job on the node where the PG server is
                    return "--nodelist=${hostname}"
                }
            }
			// Return empty string if no specific nodelist is to be set (shouldn't happen if wired correctly)
            return "" 
        }

        // Default resources for each client task.
        // These tasks will run on the same node as SETUP_POSTGRES if it has exclusive access.
        // Adjust these based on the typical needs of your import/harmonize/export scripts.
        cpus = 1          // Example: each client task uses 1 CPU
        //memory = '4.GB'   // Example: each client task might need 4GB RAM
        //time = '2h'       // Example: max time for a client task
    }

	// RUN_NUCDIFF
	withLabel: process_high {
		cpus 		= 4
		memory		= 16.GB
	}
	withLabel: process_high_cpu_time {
		cpus        = 20
		time		= { params.time_multiplier * 48.h * task.attempt }
        }
	// ANNOTATE
	withLabel: process_high_memory {
		clusterOptions 	= '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
		memory			= 200.GB

	}
	// MERGE_DBS
	withLabel: process_high_memory_time {
        clusterOptions  = '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
		memory          = 64.GB
		time			= { params.time_multiplier * 8.h * task.attempt }
		cpus			= 1
        }

	withLabel: process_high_memory_cpu_time {
        clusterOptions  = '--job-name=Saga_nxf --account=nn9305k --partition=bigmem'
        memory          = 200.GB
		cpus			= 16
        time            = { params.time_multiplier * 48.h * task.attempt }
        }
	withLabel: process_long {
		time		= { params.time_multiplier * 48.h * task.attempt } 
	}
	// INPUT, PREPARE_NUCDIFF, PREPARE_VCF_ANNOTATOR, RUN_VCF_ANNOTATOR, WRANGLING_TO_DB
	withLabel: process_short {
		time		= { params.time_multiplier * 1.h * task.attempt }
		cpus		= 1
		memory		= { 4.GB * task.attempt }
	}
	withLabel: process_local {
		executor	= 'local'
	}

}
